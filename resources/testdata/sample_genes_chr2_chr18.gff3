##gff-version 3
# Minimal pseudo-annotation for contigs '2' and '18' (32bp each)
# Provides one protein-coding gene per contig, with mRNA, exon, and CDS
2	pseudo	gene	1	20	.	+	.	ID=gene2;Name=GENE2;biotype=protein_coding
2	pseudo	mRNA	1	20	.	+	.	ID=mrna2;Parent=gene2;Name=GENE2-201
2	pseudo	exon	1	20	.	+	.	ID=exon2;Parent=mrna2
2	pseudo	CDS	5	15	.	+	0	ID=cds2;Parent=mrna2
18	pseudo	gene	1	20	.	+	.	ID=gene18;Name=GENE18;biotype=protein_coding
18	pseudo	mRNA	1	20	.	+	.	ID=mrna18;Parent=gene18;Name=GENE18-201
18	pseudo	exon	1	20	.	+	.	ID=exon18;Parent=mrna18
18	pseudo	CDS	5	15	.	+	0	ID=cds18;Parent=mrna18
